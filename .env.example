# Copia este archivo como .env.local para desarrollo en local,
# y define las mismas variables en Vercel (Project Settings → Environment Variables)
# para producción.

# Project Settings → API, en tu proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Project Settings → API → "service_role" secret.
# NUNCA la pongas en una variable NEXT_PUBLIC_*, ni la subas a git.
# Solo se usa en el servidor, para invitar a nuevas personas por email.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Avisos por email (p. ej. "te han asignado una tarea"), con Resend: resend.com
# → API Keys. Si no se define, la app funciona igual pero no manda estos avisos.
RESEND_API_KEY=re_...
# Remitente: debe ser de un dominio verificado en Resend
EMAIL_FROM="Integraly Ops <no-reply@integralyaisolutions.com>"
